# 認証情報を含まない公開APIの /api/v1 までのURLを指定してください。
VITE_API_BASE_URL=
DATABASE_URL=
RESEND_API_KEY=
KURUKURU_ALLOWED_ORIGINS=http://localhost:5173,https://s-s-lab.github.io
# 回答編集トークンのHMAC導出用。Function専用の強いランダム秘密値（32文字以上）。クライアントへ公開しない。
KURUKURU_TOKEN_SECRET=
# メール関連は3項目すべてが揃った場合だけ有効になります。
KURUKURU_MAIL_FROM="Kurukuru <no-reply@notify.kurukuru-app.jp>"
KURUKURU_PUBLIC_BASE_URL=https://kurukuru-app.jp
# 通知ワーカー専用の強いランダム秘密値。クライアントへ公開しない。
KURUKURU_NOTIFICATION_WORKER_SECRET=
